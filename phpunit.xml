<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
            Money guard. The suite reads .env for anything not pinned here, and
            .env on a working machine points the drivers at fal with a funded
            key. Without these lines `php artisan test` submits real
            generations: the end-to-end, audio and sound-effect tests each POST
            to queue.fal.run, and fal bills a submit it accepts.

            So every capability is pinned to its local fake, every model to the
            free registry entry the expectations were written against, and the
            credential to a string that is not a credential. A test that needs a
            fal adapter builds one itself with a faked HTTP layer.
        -->
        <env name="STUDIO_IMAGE_DRIVER" value="fake"/>
        <env name="STUDIO_VIDEO_DRIVER" value="fake"/>
        <env name="STUDIO_SPEECH_DRIVER" value="fake"/>
        <env name="STUDIO_MUSIC_DRIVER" value="fake"/>
        <env name="STUDIO_SFX_DRIVER" value="fake"/>
        <env name="STUDIO_IMAGE_MODEL" value="fake"/>
        <env name="STUDIO_VIDEO_MODEL" value="fake"/>
        <env name="STUDIO_SPEECH_MODEL" value="fake"/>
        <env name="STUDIO_MUSIC_MODEL" value="fake"/>
        <env name="STUDIO_SFX_MODEL" value="fake"/>
        <env name="FAL_KEY" value="not-a-real-credential"/>
    </php>
</phpunit>
